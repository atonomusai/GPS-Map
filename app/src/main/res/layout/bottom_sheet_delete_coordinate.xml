<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Big Warning Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_delete_icon_circle">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Delete"
            android:src="@drawable/ic_trash_red" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/instrument_sans_bold"
        android:text="Delete Coordinate"
        android:textColor="#111827"
        android:textSize="18sp"
        app:fontFamily="@font/instrument_sans_bold" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvDeleteMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/instrument_sans_regular"
        android:gravity="center"
        android:text="Are you sure you want to delete Point A from the measurement list?"
        android:textColor="#64748B"
        android:textSize="14sp"
        app:fontFamily="@font/instrument_sans_regular" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#4F46E5"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_delete_confirm"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

</LinearLayout>
