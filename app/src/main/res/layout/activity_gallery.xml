<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_back_button"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGalleryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="My Captures"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Search Icon Button -->
        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search captures"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSelect"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Select Action Button -->
        <TextView
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Select"
            android:textColor="#5865F2"
            android:textSize="15sp"
            android:textStyle="bold"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Expandable Search Input Row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gallery_segment_track"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout">

        <ImageView
            android:id="@+id/ivSearchPrefix"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#6B7280" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:fontFamily="@font/instrument_sans_regular"
            android:hint="Search by location or date..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="13.5sp"
            app:fontFamily="@font/instrument_sans_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCloseSearch"
            app:layout_constraintStart_toEndOf="@id/ivSearchPrefix"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnCloseSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close search"
            android:padding="4dp"
            android:src="@drawable/ic_close_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#6B7280" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3-Pill Filter Segment Bar -->
    <LinearLayout
        android:id="@+id/layoutFilterSegment"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gallery_segment_track"
        android:orientation="horizontal"
        android:padding="3.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchBar">

        <!-- Tab 1: All Media -->
        <TextView
            android:id="@+id/tabAllMedia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_gallery_segment_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="All Media (0)"
            android:textColor="#111827"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:fontFamily="@font/instrument_sans_bold" />

        <!-- Tab 2: Photos -->
        <TextView
            android:id="@+id/tabPhotos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_medium"
            android:gravity="center"
            android:text="Photos (0)"
            android:textColor="#6B7280"
            android:textSize="12.5sp"
            app:fontFamily="@font/instrument_sans_medium" />

        <!-- Tab 3: Videos -->
        <TextView
            android:id="@+id/tabVideos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_medium"
            android:gravity="center"
            android:text="Videos (0)"
            android:textColor="#6B7280"
            android:textSize="12.5sp"
            app:fontFamily="@font/instrument_sans_medium" />

    </LinearLayout>

    <!-- 3-Column Recycler Grid with Headers -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="13dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterSegment"
        tools:listitem="@layout/item_gallery_media_card"
        tools:spanCount="3" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterSegment">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_white_translucent_circle"
            android:backgroundTint="#EEF2FF">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gallery"
                app:tint="#5865F2" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="No Captures Yet"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/instrument_sans_regular"
            android:gravity="center"
            android:text="Capture moments with GPS &amp; Timestamp."
            android:textColor="#64748B"
            android:textSize="14sp"
            app:fontFamily="@font/instrument_sans_regular" />

    </LinearLayout>

    <!-- Bottom Selection Contextual Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSelectionBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2 selected" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/instrument_sans_medium"
            android:padding="6dp"
            android:text="Select All"
            android:textColor="#5865F2"
            android:textSize="13.5sp"
            app:fontFamily="@font/instrument_sans_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvSelectedCount"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutSelectionActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Share Action Button -->
            <ImageButton
                android:id="@+id/btnShareSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share selected"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_share"
                app:tint="#111827" />

            <!-- Delete Action Button -->
            <ImageButton
                android:id="@+id/btnDeleteSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete selected"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_trash_delete" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
