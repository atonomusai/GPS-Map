<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customLocationSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_drag_handle" />

        <!-- Header Row (Title + Target Icon) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCustomLocationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnTargetGps"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Custom Location Stamp"
                android:textColor="#1A1C20"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <ImageView
                android:id="@+id/btnTargetGps"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Locate GPS"
                android:padding="4dp"
                android:src="@drawable/ic_target_reticle" />

        </RelativeLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/instrument_sans_regular"
            android:lineSpacingExtra="2dp"
            android:text="Override GPS to stamp any worldwide country and city onto your media."
            android:textColor="#8E95A5"
            android:textSize="13sp"
            app:fontFamily="@font/instrument_sans_regular" />

        <!-- FIELD 1: COUNTRY / REGION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/instrument_sans_medium"
            android:text="Country / Region"
            android:textColor="#1A1C20"
            android:textSize="13sp"
            app:fontFamily="@font/instrument_sans_medium" />

        <LinearLayout
            android:id="@+id/layoutCountryContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_custom_stamp_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_world_gray" />

            <AutoCompleteTextView
                android:id="@+id/actvCountryRegion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:completionThreshold="1"
                android:dropDownAnchor="@id/layoutCountryContainer"
                android:dropDownHeight="220dp"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="4dp"
                android:fontFamily="@font/instrument_sans_medium"
                android:hint="Country / Region"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:popupBackground="@drawable/bg_popup_dropdown_tile"
                android:textColor="#1A1C20"
                android:textColorHint="#A0A6B5"
                android:textSize="14sp"
                app:fontFamily="@font/instrument_sans_medium" />

        </LinearLayout>

        <!-- Country Validation Error Text -->
        <TextView
            android:id="@+id/tvCountryError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/instrument_sans_medium"
            android:text="Please enter country first"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone"
            app:fontFamily="@font/instrument_sans_medium"
            tools:visibility="visible" />

        <!-- FIELD 2: CITY & STREET ADDRESS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/instrument_sans_medium"
            android:text="City &amp; Street Address"
            android:textColor="#1A1C20"
            android:textSize="13sp"
            app:fontFamily="@font/instrument_sans_medium" />

        <LinearLayout
            android:id="@+id/layoutCityContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_custom_stamp_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin_gray" />

            <AutoCompleteTextView
                android:id="@+id/actvCityAddress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:completionThreshold="1"
                android:dropDownAnchor="@id/layoutCityContainer"
                android:dropDownHeight="220dp"
                android:dropDownHorizontalOffset="0dp"
                android:dropDownVerticalOffset="4dp"
                android:fontFamily="@font/instrument_sans_medium"
                android:hint="City &amp; Street Address"
                android:imeOptions="actionNext"
                android:inputType="textPostalAddress|textCapSentences"
                android:maxLines="1"
                android:popupBackground="@drawable/bg_popup_dropdown_tile"
                android:textColor="#1A1C20"
                android:textColorHint="#A0A6B5"
                android:textSize="14sp"
                app:fontFamily="@font/instrument_sans_medium" />

        </LinearLayout>

        <!-- ROW 3: LATITUDE & LONGITUDE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Latitude Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans_medium"
                    android:text="Latitude"
                    android:textColor="#1A1C20"
                    android:textSize="13sp"
                    app:fontFamily="@font/instrument_sans_medium" />

                <LinearLayout
                    android:id="@+id/layoutLatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_custom_stamp_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/etLatitude"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="@font/instrument_sans_medium"
                        android:hint="Latitude"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#1A1C20"
                        android:textColorHint="#A0A6B5"
                        android:textSize="14sp"
                        app:fontFamily="@font/instrument_sans_medium" />

                </LinearLayout>

            </LinearLayout>

            <!-- Longitude Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans_medium"
                    android:text="Longitude"
                    android:textColor="#1A1C20"
                    android:textSize="13sp"
                    app:fontFamily="@font/instrument_sans_medium" />

                <LinearLayout
                    android:id="@+id/layoutLonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_custom_stamp_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/etLongitude"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="@font/instrument_sans_medium"
                        android:hint="Longitude"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#1A1C20"
                        android:textColorHint="#A0A6B5"
                        android:textSize="14sp"
                        app:fontFamily="@font/instrument_sans_medium" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Coordinates Validation Error Text -->
        <TextView
            android:id="@+id/tvCoordinatesError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/instrument_sans_medium"
            android:text="Coordinates do not match the selected country"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone"
            app:fontFamily="@font/instrument_sans_medium"
            tools:visibility="visible" />

        <!-- CARD: PICK EXACTLY ON MAP -->
        <LinearLayout
            android:id="@+id/cardPickOnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_custom_stamp_map_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Circle Badge with Pin Icon -->
            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_blue_circle_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Map Marker"
                    android:src="@drawable/ic_location" />

            </FrameLayout>

            <!-- Text Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="Pick Exactly on Map"
                    android:textColor="#1A1C20"
                    android:textSize="14sp"
                    app:fontFamily="@font/instrument_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/instrument_sans_regular"
                    android:text="Drag a pin anywhere in the world"
                    android:textColor="#8E95A5"
                    android:textSize="12sp"
                    app:fontFamily="@font/instrument_sans_regular" />

            </LinearLayout>

            <!-- Action Text -->
            <TextView
                android:id="@+id/tvOpenMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Open Map"
                android:textColor="#5263FF"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

        <!-- BOTTOM BUTTON: SAVE LOCATION TEMPLATE -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCustomizeTemplate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn_customize_template"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Save Location Template"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
