<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top Bar with Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnLocationsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_back_button"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark" />

        <TextView
            android:id="@+id/tvLocationsHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Popular Cities &amp; Locations"
            android:textColor="#0F172A"
            android:textSize="18sp"
            app:fontFamily="@font/instrument_sans_bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Featured Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Featured"
                android:textColor="#0F172A"
                android:textSize="17sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeaturedLocations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="4dp"
                android:paddingBottom="14dp"
                tools:listitem="@layout/item_featured_location_card" />

            <!-- Filter Chips Row -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilterChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                tools:listitem="@layout/item_location_filter_chip" />

            <!-- Count Header -->
            <TextView
                android:id="@+id/tvResultsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_regular"
                tools:text="Showing 38 cities" />

            <!-- City List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCityLocations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_city_camera_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
