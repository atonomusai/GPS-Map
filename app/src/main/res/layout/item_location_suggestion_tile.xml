<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <!-- Left Circular Icon Badge -->
    <FrameLayout
        android:id="@+id/flIconBadge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_blue_circle_badge">

        <ImageView
            android:id="@+id/ivSuggestionIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_location" />

    </FrameLayout>

    <!-- Middle Text Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSuggestionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/instrument_sans_bold"
            android:maxLines="1"
            tools:text="Miami Beach, United States"
            android:textColor="#1A1C20"
            android:textSize="14sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/tvSuggestionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/instrument_sans_regular"
            android:maxLines="1"
            tools:text="Miami Beach, Ocean Drive, FL"
            android:textColor="#8E95A5"
            android:textSize="12sp"
            app:fontFamily="@font/instrument_sans_regular" />

    </LinearLayout>

    <!-- Right Coordinate Tag -->
    <TextView
        android:id="@+id/tvSuggestionTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_coord_tag"
        android:fontFamily="@font/instrument_sans_medium"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="25.7° N"
        android:textColor="#5E6472"
        android:textSize="11sp"
        app:fontFamily="@font/instrument_sans_medium" />

</LinearLayout>
