<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tripHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- 1. TOP ACTION BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_back_button"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Trip History"
            android:textColor="#111827"
            android:textSize="18sp"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Placeholder for symmetry -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. SOURCE SEGMENTED TABS (Speedometer vs Route Finder) -->
    <LinearLayout
        android:id="@+id/layoutSourceTabs"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_trip_source_track"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar">

        <TextView
            android:id="@+id/tvSourceSpeedometer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_trip_source_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Speedometer"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/tvSourceRouteFinder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Route Finder"
            android:textColor="#64748B"
            android:textSize="13.5sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

    <!-- 3. FILTER PILLS (All | Today | This Week | This Month) -->
    <HorizontalScrollView
        android:id="@+id/hsvFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSourceTabs">

        <LinearLayout
            android:id="@+id/layoutFilterPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_trip_filter_pill_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/instrument_sans_bold"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="18dp"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvTabToday"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_trip_filter_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/instrument_sans_medium"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingHorizontal="18dp"
                android:text="Today"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_medium" />

            <TextView
                android:id="@+id/tvTabThisWeek"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_trip_filter_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/instrument_sans_medium"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingHorizontal="18dp"
                android:text="This Week"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_medium" />

            <TextView
                android:id="@+id/tvTabThisMonth"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_trip_filter_pill_unselected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/instrument_sans_medium"
                android:gravity="center"
                android:minWidth="90dp"
                android:paddingHorizontal="18dp"
                android:text="This Month"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_medium" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- 4. SUMMARY BANNER CARD (TRIPS | DISTANCE | AVG SPEED) -->
    <LinearLayout
        android:id="@+id/layoutSummaryBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_summary_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsvFilters">

        <!-- Column 1: TRIPS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Trips Icon"
                android:src="@drawable/ic_navigation_arrow"
                app:tint="#5663FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:letterSpacing="0.05"
                android:text="TRIPS"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvSummaryTripsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="0"
                android:textColor="#0F172A"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

        <!-- Vertical Divider 1 -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#E0E7FF" />

        <!-- Column 2: DISTANCE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Distance Icon"
                android:src="@drawable/ic_map_folded"
                app:tint="#5663FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:letterSpacing="0.05"
                android:text="DISTANCE"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvSummaryDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="0.0 km"
                android:textColor="#0F172A"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

        <!-- Vertical Divider 2 -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#E0E7FF" />

        <!-- Column 3: AVG SPEED -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Avg Speed Icon"
                android:src="@drawable/ic_trip_chart_trend"
                app:tint="#5663FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:letterSpacing="0.05"
                android:text="AVG SPEED"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvSummaryAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="0.0 km/h"
                android:textColor="#0F172A"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- 5. SECTION TITLE: RECENT TRIPS -->
    <TextView
        android:id="@+id/tvSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/instrument_sans_bold"
        android:letterSpacing="0.05"
        android:text="RECENT TRIPS"
        android:textColor="#64748B"
        android:textSize="12.5sp"
        app:fontFamily="@font/instrument_sans_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSummaryBanner" />

    <!-- 6. RECYCLER VIEW FOR TRIP HISTORY -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTripHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionHeader" />

    <!-- 7. EMPTY STATE VIEW -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsvFilters">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="No trips"
            android:src="@drawable/ic_trip_history"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="No Trips Recorded Yet"
            android:textColor="#111827"
            android:textSize="16sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/instrument_sans_regular"
            android:text="Your completed speedometer trips will appear here"
            android:textColor="#64748B"
            android:textSize="13sp"
            app:fontFamily="@font/instrument_sans_regular" />

    </LinearLayout>

    <!-- 8. BOTTOM EXPORT BUTTON -->
    <LinearLayout
        android:id="@+id/layoutExportBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnExportTrips"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_export_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Export Icon"
                android:src="@drawable/ic_export_trips"
                app:tint="#4F46E5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Export All Trips"
                android:textColor="#4F46E5"
                android:textSize="14.5sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
