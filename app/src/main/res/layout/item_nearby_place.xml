<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlaceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_trip_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Left: Category Icon Circle Badge -->
    <FrameLayout
        android:id="@+id/layoutCategoryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_nearby_badge">

        <TextView
            android:id="@+id/tvCategoryEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⛽"
            android:textSize="20sp" />

    </FrameLayout>

    <!-- Center: Place Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Place Name -->
        <TextView
            android:id="@+id/tvPlaceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/instrument_sans_bold"
            android:maxLines="1"
            android:text="Place Name"
            android:textColor="#0F172A"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <!-- Subtitle: Street / Area • Distance -->
        <TextView
            android:id="@+id/tvPlaceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/instrument_sans_regular"
            android:maxLines="1"
            android:text="Main Street • 0.3 km away"
            android:textColor="#64748B"
            android:textSize="12sp"
            app:fontFamily="@font/instrument_sans_regular" />

        <!-- Status Tag Line -->
        <TextView
            android:id="@+id/tvPlaceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="• 🟢 Open Now"
            android:textColor="#059669"
            android:textSize="11sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

    <!-- Right: Quick Action Buttons (Share & Directions Arrow) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Share Button -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share Place"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu_share"
            app:tint="#94A3B8" />

        <!-- Directions Right Arrow Button -->
        <FrameLayout
            android:id="@+id/btnDirections"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_arrow_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Directions"
                android:src="@drawable/ic_arrow_forward_blue" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
