<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvEditDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Edit Point A"
            android:textColor="#111827"
            android:textSize="18sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="4dp"
            android:src="@drawable/ic_close_gray" />

    </RelativeLayout>

    <!-- Latitude Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/instrument_sans_bold"
        android:text="Latitude (-90 to 90)"
        android:textColor="#374151"
        android:textSize="13sp"
        app:fontFamily="@font/instrument_sans_bold" />

    <EditText
        android:id="@+id/etEditLatitude"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/instrument_sans_regular"
        android:hint="e.g. 28.6139"
        android:inputType="numberDecimal|numberSigned"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp"
        app:fontFamily="@font/instrument_sans_regular" />

    <TextView
        android:id="@+id/tvEditLatError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/instrument_sans_regular"
        android:textColor="#EF4444"
        android:textSize="11sp"
        android:visibility="gone"
        app:fontFamily="@font/instrument_sans_regular" />

    <!-- Longitude Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/instrument_sans_bold"
        android:text="Longitude (-180 to 180)"
        android:textColor="#374151"
        android:textSize="13sp"
        app:fontFamily="@font/instrument_sans_bold" />

    <EditText
        android:id="@+id/etEditLongitude"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/instrument_sans_regular"
        android:hint="e.g. 77.2090"
        android:inputType="numberDecimal|numberSigned"
        android:paddingHorizontal="14dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="14sp"
        app:fontFamily="@font/instrument_sans_regular" />

    <TextView
        android:id="@+id/tvEditLonError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/instrument_sans_regular"
        android:textColor="#EF4444"
        android:textSize="11sp"
        android:visibility="gone"
        app:fontFamily="@font/instrument_sans_regular" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#4F46E5"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <TextView
            android:id="@+id/btnSaveEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_trip_add_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

</LinearLayout>
