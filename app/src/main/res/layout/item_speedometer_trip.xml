<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSpeedometerTrip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_speedometer_trip_card"
    android:elevation="1dp"
    android:foreground="?attr/selectableItemBackground">

    <!-- Left Colored Status Strip Indicator -->
    <View
        android:id="@+id/viewStatusStrip"
        android:layout_width="4.5dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_status_strip_left_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TOP ROW: TITLE & TIMESTAMP -->
        <TextView
            android:id="@+id/tvTripTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/instrument_sans_bold"
            android:maxLines="1"
            android:text="Trip #24 — Main Highway"
            android:textColor="#111827"
            android:textSize="14.5sp"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintEnd_toStartOf="@id/tvTripDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTripDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_regular"
            android:text="19 Sep 2026 14:32"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            app:fontFamily="@font/instrument_sans_regular"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTripTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- MIDDLE ROW: 3 METRICS (Distance | Time | Avg Speed) -->
        <LinearLayout
            android:id="@+id/layoutMetricsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTripTitle">

            <!-- 1. Distance Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Distance"
                    android:src="@drawable/boxicons_location"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="14.8 km"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/instrument_sans_bold" />

            </LinearLayout>

            <!-- 2. Time Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Duration"
                    android:src="@drawable/griddy_icons_time"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="00:42:15"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/instrument_sans_bold" />

            </LinearLayout>

            <!-- 3. Avg Speed Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Avg Speed"
                    android:src="@drawable/ic_trip_speed_pulse"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="34.2 km/h"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/instrument_sans_bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER LINE -->
        <View
            android:id="@+id/dividerLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#F1F5F9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutMetricsRow" />

        <!-- BOTTOM ROW: MAX SPEED & STATUS BADGE -->
        <TextView
            android:id="@+id/tvMaxSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/instrument_sans_regular"
            android:text="Max Speed: 82.1 km/h"
            android:textColor="#64748B"
            android:textSize="12sp"
            app:fontFamily="@font/instrument_sans_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvStatusBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerLine" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge_safe"
            android:fontFamily="@font/instrument_sans_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:text="Safe"
            android:textColor="#16A34A"
            android:textSize="11.5sp"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerLine" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
