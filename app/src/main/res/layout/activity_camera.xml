<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/black">

    <!-- 1. Live Camera Preview (Edge-to-Edge) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Viewfinder Container (Active region between Top Bar and Bottom Controls) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewfinderContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topControlsBar"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Viewfinder Framing Overlay (Corner Brackets) -->
        <ImageView
            android:id="@+id/ivViewfinderBrackets"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="14dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/viewfinder_corner_brackets"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Center Target Focus Reticle [ + ] -->
        <ImageView
            android:id="@+id/ivCenterReticle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@null"
            android:src="@drawable/viewfinder_center_reticle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.44" />

        <!-- Stamp Overlay View (Drawn GPS Card & Timestamps) -->
        <com.autonoumus.ai.presentation.camera.view.StampOverlayView
            android:id="@+id/stampOverlayView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. Tap-to-Focus Ring Animation -->
    <ImageView
        android:id="@+id/ivFocusRing"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/bg_focus_ring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Top Bar Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topControlsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Flash Mode Button (Pill with Icon + Text) -->
        <LinearLayout
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_camera_top_pill"
            android:gravity="center"
            android:minWidth="84dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFlashIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_flash_bolt"
                app:tint="#F59E0B" />

            <TextView
                android:id="@+id/tvFlashText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="AUTO"
                android:textColor="#F59E0B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Switch Camera Button (Circle) -->
        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_camera_top_circle"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_switch_camera_rotate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnFlash"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <!-- Resolution & FPS Pill -->
        <TextView
            android:id="@+id/tvResolutionStatus"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_camera_top_pill"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCameraSettings"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1080P • 60 FPS" />

        <!-- Camera Settings Button (Circle) -->
        <ImageView
            android:id="@+id/btnCameraSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_camera_top_circle"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_setting"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recording Timer Header (shown during video recording) -->
    <TextView
        android:id="@+id/tvRecordingTimer"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_camera_top_pill"
        android:fontFamily="@font/instrument_sans_bold"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingHorizontal="12dp"
        android:textColor="#EF4444"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topControlsBar"
        tools:text="● 00:12" />

    <!-- GPS Disabled Warning Banner (Orange Pill per Image 2) -->
    <LinearLayout
        android:id="@+id/bannerGpsDisabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_gps_disabled"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topControlsBar"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGpsDisabledIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_triangle"
            app:tint="#1E293B" />

        <TextView
            android:id="@+id/tvGpsDisabledText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="GPS Disabled – Tap to Enable"
            android:textColor="#1E293B"
            android:textSize="13sp" />

       <!-- <View
            android:id="@+id/dividerGpsDisabled"
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:background="#40000000" />

        <ImageView
            android:id="@+id/btnEditCustomLocation"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Custom Location"
            android:padding="1dp"
            android:src="@drawable/ic_edit_pencil"
            app:tint="#1E293B" />
-->
    </LinearLayout>

    <!-- 5. Bottom Controls Container (Dedicated Dark Dock matching Reference UI) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_bottom_dock_scrim"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mode Toggle Pill (PHOTO / VIDEO with icon support for landscape) -->
        <LinearLayout
            android:id="@+id/layoutModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_mode_pill_container"
            android:orientation="horizontal"
            android:padding="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Photo Button Container -->
            <FrameLayout
                android:id="@+id/btnModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mode_pill_active_amber">

                <TextView
                    android:id="@+id/tvModePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingHorizontal="18dp"
                    android:text="PHOTO"
                    android:textColor="@android:color/black"
                    android:textSize="12.5sp" />

                <ImageView
                    android:id="@+id/ivModePhoto"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:src="@drawable/ic_camera"
                    android:visibility="gone"
                    app:tint="@android:color/black" />

            </FrameLayout>

            <!-- Video Button Container -->
            <FrameLayout
                android:id="@+id/btnModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/tvModeVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingHorizontal="18dp"
                    android:text="VIDEO"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp" />

                <ImageView
                    android:id="@+id/ivModeVideo"
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:src="@drawable/ic_video_home"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Shutter & Tool Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/captureRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutModeToggle">

            <!-- Gallery Button (Left) -->
            <LinearLayout
                android:id="@+id/btnThumbnail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/flThumbnailCircle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_camera_top_circle">

                    <ImageView
                        android:id="@+id/ivThumbnail"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_gallery"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvGalleryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:letterSpacing="0.05"
                    android:text="GALLERY"
                    android:textColor="@android:color/white"
                    android:textSize="9.5sp" />

            </LinearLayout>

            <!-- Pause / Resume Recording Button (Left during recording) -->
            <ImageView
                android:id="@+id/btnPauseResume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_camera_top_circle"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_pause_white"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white"
                tools:visibility="visible" />

            <!-- Shutter Button Container (Center) -->
            <FrameLayout
                android:id="@+id/captureButtonContainer"
                android:layout_width="78dp"
                android:layout_height="78dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Outer Ring -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_capture_ring" />

                <!-- Inner Capture / Record / Stop Button -->
                <View
                    android:id="@+id/btnCapture"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_capture_button_photo" />

            </FrameLayout>

            <!-- Templates Button (Right) -->
            <LinearLayout
                android:id="@+id/btnTemplatesQuick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <FrameLayout
                    android:id="@+id/flTemplatesCircle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_camera_top_circle">

                    <ImageView
                        android:id="@+id/ivTemplatesIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_templates_layers"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvTemplatesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:letterSpacing="0.05"
                    android:text="TEMPLATES"
                    android:textColor="@android:color/white"
                    android:textSize="9.5sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Capture/Save Loading Overlay (shown from the moment a photo/video is captured until it
         is fully saved and reflected in the "recent capture" thumbnail) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaptureSaving"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/flCaptureSavingBadge"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintBottom_toTopOf="@id/tvCaptureSavingText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ProgressBar
                android:id="@+id/progressCaptureSaving"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#F59E0B"
                android:indeterminateTintMode="src_in" />

            <ImageView
                android:id="@+id/ivCaptureSavingIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_camera"
                app:tint="@android:color/white" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvCaptureSavingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flCaptureSavingBadge"
            tools:text="Capturing your shot…" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permission-required overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPermissionRequired"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F0000000"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tvPermissionMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_medium"
            android:gravity="center"
            android:text="Camera and microphone access are required to take GPS-stamped photos and videos."
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/btnGrantPermission"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Grant Access"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@id/btnOpenAppSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPermissionMessage" />

        <TextView
            android:id="@+id/btnOpenAppSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/instrument_sans_semibold"
            android:padding="8dp"
            android:text="Open App Settings"
            android:textColor="#B8C1FF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGrantPermission" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
