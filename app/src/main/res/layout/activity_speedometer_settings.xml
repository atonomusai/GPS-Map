<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speedometerSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC">

    <!-- 1. TOP ACTION BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Setting"
            android:textColor="#111827"
            android:textSize="18sp"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <!-- HERO BELL ILLUSTRATION (Concentric pulse rings + dots) -->
            <ImageView
                android:id="@+id/ivHeroBell"
                android:layout_width="140dp"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Speed Alert Hero"
                android:scaleType="fitCenter"
                android:src="@drawable/img_speed_alert_bell_hero" />

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Speed Alert"
                android:textColor="#111827"
                android:textSize="20sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:text="Get notified when you exceed your speed limit."
                android:textColor="#64748B"
                android:textSize="13sp"
                app:fontFamily="@font/instrument_sans_regular" />

            <!-- CARD 1: SPEED LIMIT SLIDER CARD -->
            <LinearLayout
                android:id="@+id/cardSpeedLimitSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_speed_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="Speed Limit"
                    android:textColor="#4F46E5"
                    android:textSize="15sp"
                    app:fontFamily="@font/instrument_sans_bold" />

                <!-- Minus, Number, Plus Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMinusLimit"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Decrease Limit"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_speed_minus_circle" />

                    <TextView
                        android:id="@+id/tvSpeedLimitLarge"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/instrument_sans_bold"
                        android:gravity="center"
                        android:text="60"
                        android:textColor="#4F46E5"
                        android:textSize="44sp"
                        app:fontFamily="@font/instrument_sans_bold" />

                    <ImageButton
                        android:id="@+id/btnPlusLimit"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Increase Limit"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_speed_plus_circle" />

                </LinearLayout>

                <!-- SeekBar Slider -->
                <SeekBar
                    android:id="@+id/seekBarSpeedLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="150"
                    android:progress="30"
                    android:progressBackgroundTint="#E2E8F0"
                    android:progressTint="#4F46E5"
                    android:thumbTint="#4F46E5" />

                <!-- Range Labels (30 on left, 180 on right) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/instrument_sans_medium"
                        android:text="30"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        app:fontFamily="@font/instrument_sans_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/instrument_sans_medium"
                        android:text="180"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        app:fontFamily="@font/instrument_sans_medium" />

                </RelativeLayout>

            </LinearLayout>

            <!-- SECTION 2: ALERT PREFERENCES HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="ALERT PREFERENCES"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <!-- ALERT PREFERENCES CARD CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_speed_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- ROW 1: Speed Limit Alert -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Speed Alert"
                        android:src="@drawable/ic_speed_alert_bell_plate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans_bold"
                            android:text="Speed Limit Alert"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:fontFamily="@font/instrument_sans_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/instrument_sans_regular"
                            android:text="Play alert tone when exceeding limit"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:fontFamily="@font/instrument_sans_regular" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSpeedAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumb="@drawable/bg_switch_thumb"
                        app:track="@drawable/bg_switch_track"
                        app:showText="false"
                        app:useMaterialThemeColors="false" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="#F1F5F9" />

                <!-- ROW 2: Vibration Alert -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Vibration Alert"
                        android:src="@drawable/ic_speed_vibrate_plate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans_bold"
                            android:text="Vibration Alert"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:fontFamily="@font/instrument_sans_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/instrument_sans_regular"
                            android:text="Haptic feedback on speed violation"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:fontFamily="@font/instrument_sans_regular" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVibrationAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumb="@drawable/bg_switch_thumb"
                        app:track="@drawable/bg_switch_track"
                        app:showText="false"
                        app:useMaterialThemeColors="false" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="#F1F5F9" />

                <!-- ROW 3: Custom Speed Limit Tolerance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Tolerance"
                        android:src="@drawable/ic_speed_tolerance_plate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans_bold"
                            android:text="Custom Speed Limit Tolerance"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:fontFamily="@font/instrument_sans_bold" />

                        <TextView
                            android:id="@+id/tvToleranceSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/instrument_sans_regular"
                            android:text="Allow +5 KM/H buffer before alert"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:fontFamily="@font/instrument_sans_regular" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTolerance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/bg_switch_thumb"
                        app:track="@drawable/bg_switch_track"
                        app:showText="false"
                        app:useMaterialThemeColors="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
