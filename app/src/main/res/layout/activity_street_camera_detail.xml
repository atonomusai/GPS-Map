<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:orientation="vertical"
    android:weightSum="1.0"
    tools:context=".presentation.streetcamera.StreetCameraDetailActivity">

    <!-- 1. TOP LIVE CAMERA VIEW (70% Vertical Space) -->
    <FrameLayout
        android:id="@+id/frameLiveCameraStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.70"
        android:background="#000000">

        <ImageView
            android:id="@+id/ivDetailImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_street_view_mountain" />

        <ProgressBar
            android:id="@+id/progressDetailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white" />

        <TextView
            android:id="@+id/tvDetailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/instrument_sans_semibold"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:fontFamily="@font/instrument_sans_semibold"
            tools:text="Unable to load this camera."
            tools:visibility="visible" />

        <!-- Top Bar Actions -->
        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_circular_back_button"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark" />

        <!-- Bottom Scrim on Live Camera Feed -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_media_bottom_scrim" />

        <!-- Camera Metadata Overlay at bottom of feed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailLiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_red"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2.5dp"
                    android:text="@string/camera_live_badge"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:fontFamily="@font/instrument_sans_bold" />

                <TextView
                    android:id="@+id/tvDetailLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/instrument_sans_medium"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:fontFamily="@font/instrument_sans_medium"
                    tools:text="Updated 12m ago"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_bold"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold"
                tools:text="Parma › North-west" />

            <TextView
                android:id="@+id/tvDetailSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_regular"
                android:maxLines="1"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:fontFamily="@font/instrument_sans_regular"
                tools:text="Parma, Italy" />

            <TextView
                android:id="@+id/btnWatchTimelapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_radius_pill"
                android:fontFamily="@font/instrument_sans_bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/watch_timelapse"
                android:textColor="#4F46E5"
                android:textSize="12sp"
                android:visibility="gone"
                app:fontFamily="@font/instrument_sans_bold"
                tools:visibility="visible" />

        </LinearLayout>
    </FrameLayout>

    <!-- 2. MORE SUGGESTIONS SECTION (30% Vertical Space) -->
    <LinearLayout
        android:id="@+id/layoutSuggestionsSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.30"
        android:background="#0A0A0C"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSuggestionsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:text="More Suggestions"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_camera_suggestion" />

            <ProgressBar
                android:id="@+id/progressSuggestionsLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Attribution -->
        <TextView
            android:id="@+id/tvDetailAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_regular"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/windy_attribution"
            android:textColor="#64748B"
            android:textSize="10sp"
            app:fontFamily="@font/instrument_sans_regular" />
    </LinearLayout>

</LinearLayout>
