<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/compassRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:fitsSystemWindows="true">

    <!-- Top App Bar / Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_back_button"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCompassTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Compass &amp; Altimeter"
            android:textColor="#1A1C20"
            android:textSize="18sp"
            app:fontFamily="@font/instrument_sans_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnOverflowMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more_vert_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomButtonsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- MAIN TOP COMPASS CARD -->
            <LinearLayout
                android:id="@+id/cardCompass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="18dp">

                <!-- Compass Dial Container -->
                <FrameLayout
                    android:id="@+id/compassDialContainer"
                    android:layout_width="240dp"
                    android:layout_height="240dp">

                    <!-- Theme Dial Image View (Rotates in real-time) -->
                    <ImageView
                        android:id="@+id/ivThemeCompassDial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Compass Theme Dial"
                        android:scaleType="centerInside"
                        android:visibility="gone"
                        tools:src="@drawable/img_theme_classic_dial"
                        tools:visibility="visible" />

                    <!-- Rotating Canvas Compass View -->
                    <com.autonoumus.ai.presentation.compass.CompassDialView
                        android:id="@+id/compassDialView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Top Fixed Red Heading Indicator Pointer -->
                    <ImageView
                        android:id="@+id/ivCompassPointer"
                        android:layout_width="12dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="2dp"
                        android:contentDescription="Pointer"
                        android:src="@drawable/ic_compass_pointer" />

                    <!-- Center Readout Circle -->
                    <LinearLayout
                        android:id="@+id/centerReadoutLayout"
                        android:layout_width="105dp"
                        android:layout_height="105dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_compass_center_circle"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeadingDegree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans_bold"
                            android:text="245°"
                            android:textColor="#1A1C20"
                            android:textSize="28sp"
                            app:fontFamily="@font/instrument_sans_bold" />

                        <TextView
                            android:id="@+id/tvDirectionCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans_bold"
                            android:text="SW"
                            android:textColor="#FF3B30"
                            android:textSize="14sp"
                            app:fontFamily="@font/instrument_sans_bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Direction Name and Magnetic Declination -->
                <TextView
                    android:id="@+id/tvDirectionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/instrument_sans_bold"
                    android:text="South-West"
                    android:textColor="#1A1C20"
                    android:textSize="16sp"
                    app:fontFamily="@font/instrument_sans_bold" />

                <TextView
                    android:id="@+id/tvMagneticDeclination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/instrument_sans_regular"
                    android:text="Magnetic Declination +1.8°"
                    android:textColor="#8E95A5"
                    android:textSize="12sp"
                    app:fontFamily="@font/instrument_sans_regular" />

            </LinearLayout>

            <!-- 2x2 METRIC CARDS -->
            <!-- ROW 1: ALTITUDE & BAROMETER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- CARD 1: ALTITUDE -->
                <LinearLayout
                    android:id="@+id/cardAltitude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_badge_green"
                            android:contentDescription="Altitude"
                            android:padding="5dp"
                            android:src="@drawable/ic_altitude_metric" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/instrument_sans_semibold"
                            android:letterSpacing="0.03"
                            android:text="ALTITUDE"
                            android:textColor="#7E8594"
                            android:textSize="11sp"
                            app:fontFamily="@font/instrument_sans_semibold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAltitudeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/instrument_sans_bold"
                        android:text="540 m"
                        android:textColor="#1A1C20"
                        android:textSize="18sp"
                        app:fontFamily="@font/instrument_sans_bold" />

                    <TextView
                        android:id="@+id/tvAltitudeAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/instrument_sans_regular"
                        android:text="Accuracy: ±2m"
                        android:textColor="#8E95A5"
                        android:textSize="11sp"
                        app:fontFamily="@font/instrument_sans_regular" />

                </LinearLayout>

                <!-- CARD 2: BAROMETER -->
                <LinearLayout
                    android:id="@+id/cardBarometer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_badge_blue"
                            android:contentDescription="Barometer"
                            android:padding="5dp"
                            android:src="@drawable/ic_speedo_meter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/instrument_sans_semibold"
                            android:letterSpacing="0.03"
                            android:text="BAROMETER"
                            android:textColor="#7E8594"
                            android:textSize="11sp"
                            app:fontFamily="@font/instrument_sans_semibold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBarometerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/instrument_sans_bold"
                        android:text="1013.2 hPa"
                        android:textColor="#1A1C20"
                        android:textSize="18sp"
                        app:fontFamily="@font/instrument_sans_bold" />

                    <TextView
                        android:id="@+id/tvBarometerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/instrument_sans_regular"
                        android:text="Standard Pressure"
                        android:textColor="#8E95A5"
                        android:textSize="11sp"
                        app:fontFamily="@font/instrument_sans_regular" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2: SUNRISE & COORDINATES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- CARD 3: SUNRISE -->
                <LinearLayout
                    android:id="@+id/cardSunrise"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_badge_yellow"
                            android:contentDescription="Sunrise"
                            android:padding="5dp"
                            android:src="@drawable/ic_sunrise_metric" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/instrument_sans_semibold"
                            android:letterSpacing="0.03"
                            android:text="SUNRISE"
                            android:textColor="#7E8594"
                            android:textSize="11sp"
                            app:fontFamily="@font/instrument_sans_semibold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSunriseValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/instrument_sans_bold"
                        android:text="05:28 AM"
                        android:textColor="#1A1C20"
                        android:textSize="18sp"
                        app:fontFamily="@font/instrument_sans_bold" />

                    <TextView
                        android:id="@+id/tvSunsetValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/instrument_sans_regular"
                        android:text="Sunset: 06:58 PM"
                        android:textColor="#8E95A5"
                        android:textSize="11sp"
                        app:fontFamily="@font/instrument_sans_regular" />

                </LinearLayout>

                <!-- CARD 4: COORDINATES -->
                <LinearLayout
                    android:id="@+id/cardCoordinates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_badge_purple"
                            android:contentDescription="Coordinates"
                            android:padding="5dp"
                            android:src="@drawable/ic_world" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/instrument_sans_semibold"
                            android:letterSpacing="0.03"
                            android:text="COORDINATES"
                            android:textColor="#7E8594"
                            android:textSize="11sp"
                            app:fontFamily="@font/instrument_sans_semibold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCoordLat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/instrument_sans_bold"
                        android:text="33.7294° N"
                        android:textColor="#1A1C20"
                        android:textSize="18sp"
                        app:fontFamily="@font/instrument_sans_bold" />

                    <TextView
                        android:id="@+id/tvCoordLong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/instrument_sans_regular"
                        android:text="73.0551° E"
                        android:textColor="#8E95A5"
                        android:textSize="11sp"
                        app:fontFamily="@font/instrument_sans_regular" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION BUTTONS -->
    <LinearLayout
        android:id="@+id/bottomButtonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary: Open Compass on Camera -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenCameraCompass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_save_pill"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Open Compass on Camera"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

        <!-- Secondary: Change Compass -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChangeCompass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_outline_pill"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Change Compass"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
