<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_drag_handle" />

    <!-- Title Row with Blue Checkmark -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Area Calculated"
                android:textColor="#4F46E5"
                android:textSize="16sp"
                app:fontFamily="@font/instrument_sans_bold" />

            <TextView
                android:id="@+id/tvResultLocationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="Current Location"
                android:textColor="#111827"
                android:textSize="18sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_success_circle">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Calculated"
                android:src="@drawable/ic_check_blue" />
        </FrameLayout>

    </RelativeLayout>

    <!-- 2 SIDE-BY-SIDE METRIC CARDS (Area & Perimeter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Card 1: Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_regular"
                android:text="Area"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:fontFamily="@font/instrument_sans_regular" />

            <TextView
                android:id="@+id/tvResultAreaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="2,450.8 m²"
                android:textColor="#111827"
                android:textSize="16sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

        <!-- Card 2: Perimeter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_regular"
                android:text="Perimeter"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:fontFamily="@font/instrument_sans_regular" />

            <TextView
                android:id="@+id/tvResultPerimeterValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/instrument_sans_bold"
                android:text="496.85 m"
                android:textColor="#111827"
                android:textSize="16sp"
                app:fontFamily="@font/instrument_sans_bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- SAVE & SHARE BUTTON -->
    <LinearLayout
        android:id="@+id/btnSaveAndShare"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_trip_add_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Share"
            android:src="@drawable/ic_download_save"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="Save &amp; Share"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:fontFamily="@font/instrument_sans_bold" />

    </LinearLayout>

</LinearLayout>
