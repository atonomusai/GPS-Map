<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stampRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dark Capsule / Pill Body -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_stamp_capsule"
        android:paddingHorizontal="40dp"
        android:paddingTop="26dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Bottom Guideline to balance center & bottom placement -->

        <LinearLayout
            android:id="@+id/layoutTexts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Top Time Header (e.g. ⏰ 4:23 PM) -->
            <TextView
                android:id="@+id/tvTimeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="⏰ 4:23 PM"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Location / Address Line -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_regular"
                android:gravity="center"
                android:paddingStart="18dp"
                android:maxLines="2"
                android:text="Pisa, 56126 pisa, Province of paisa,Italy"
                android:textColor="#E5E7EB"
                android:textSize="10dp" />

            <!-- Coordinates Line (Lat: ... | Long: ...) -->
            <TextView
                android:paddingStart="18dp"
                android:id="@+id/tvCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/instrument_sans_regular"
                android:gravity="center"
                android:maxLines="1"
                android:text="Lat: 43.7311°    |    Long: 10.3965°"
                android:textColor="#CBD5E1"
                android:textSize="10dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Center Popping Circular Map Badge with Guaranteed Circle Clip -->
    <FrameLayout
        android:id="@+id/layoutMapBadge"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Circular Map Image -->
        <com.autonoumus.ai.core.stamp.view.RoundedImageView
            android:id="@+id/ivMapBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Map Badge"
            android:scaleType="centerCrop"
            android:src="@drawable/img_map_normal"
            app:riv_isCircle="true"
            app:riv_strokeColor="#FFFFFF"
            app:riv_strokeWidth="1.5dp" />

        <!-- Center Red Location Pin -->
        <ImageView
            android:id="@+id/ivMapPin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Pin"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_map_pin_red"
            android:translationY="-2dp" />

    </FrameLayout>

    <!-- Edit Pencil Circle (Top-Right Corner per Image 2) -->
    <ImageView
        android:id="@+id/ivEditIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_edit_circle"
        android:contentDescription="Edit"
        android:padding="3.5dp"
        android:src="@drawable/ic_edit_pen"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cardCapsule"
        app:layout_constraintTop_toTopOf="@id/cardCapsule"
        app:tint="#FFFFFF"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
