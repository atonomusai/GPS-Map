<?xml version="1.0" encoding="utf-8"?>
<!-- Only the folders the app actually shares from (ImportImageStampActivity: stamped photo/video
     copies in cacheDir). Broad roots such as external-path "." exposed all shared storage through
     the FileProvider and are flagged by Play's security checks. -->
<paths>
    <cache-path name="shared_images" path="images/" />
    <cache-path name="shared_videos" path="videos/" />
</paths>
